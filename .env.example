# ==========================================
# ⚙️ DAP-COMMERCE: ENVIRONMENT VARIABLES
# Instructions: Copy this file, rename to .env.local, and fill in your keys.
# ==========================================

# 1. DATABASE (Supabase)
# ------------------------------------------
# USIN SUPABASE & ORM (Prisma)
# Find these in Supabase -> Project Settings -> Database
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
DATABASE_PASSWORD="your_database_password_here"

# 2. AUTHENTICATION (Auth.js[NextAuth.js])
# ------------------------------------------
# Generate random secret via terminal: openssl rand -base64 32
# or If you prefer Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="generate_a_random_32_character_string_here"

# Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

# 3. NOTIFICATIONS & EMAIL (Resend)
# ------------------------------------------
# Get API key from resend.com
API_KEY_RESEND="re_your_resend_api_key_here"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD="re_your_resend_api_key_here"
# Defaults for Resend SMTP (Leave as is)
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="465"
EMAIL_FROM="onboarding@resend.dev" 

# 4. PAYMENTS (Razorpay)
# ------------------------------------------
# Use test mode keys for local development
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# 5. MEDIA & STORAGE (Cloudinary)
# ------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_URL="cloudinary://[API_KEY]:[API_SECRET]@[CLOUD_NAME]"

# 6. MICROSERVICES (Render ML Backend)
# ------------------------------------------
# Generate random secret via terminal: openssl rand -base64 32
CROP_AI_SECRET_KEY="your_crop_ai_internal_secret"
# These are public/internal routing endpoints
# Remote Render hosted endpoint
AI_API_URL_RENDER="https://crop-ai-backend-cl8d.onrender.com/predict"
# Test Local 
AI_API_URL_LOCAL="http://localhost:8000/predict"
